# DX Console: internal management portal for the DX owners only.
# Uses the same Supabase project as the public site.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Transaction pooler (port 6543). Server-side only.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# The only people who can sign in. Comma-separated. Anyone else is refused.
CONSOLE_OWNER_EMAILS=mitesh@example.com,prachi@example.com,bret@example.com

# Base URL of this console, used for sign-in links.
CONSOLE_URL=http://localhost:3001

# Public site, for links out to live pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
