# Hosted Supabase project used for testing and production (Project Settings > API).
# Use an EU region (London / Frankfurt). No local Docker database is required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Postgres connection strings (Project Settings > Database > Connection string).
# Runtime: transaction pooler (port 6543). Migrations: session pooler / direct (port 5432).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Public base URL, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DX Console (internal owners' app in ./console). Owner accounts are sent here.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
